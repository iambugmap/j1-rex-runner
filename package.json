{
  "name": "j1-rex-runner",
  "private": true,
  "version": "0.1.0",
  "description": "J1 Rex - pixel endless runner for the web and Telegram Mini Apps",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "cover": "node scripts/generate-cover-image.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
